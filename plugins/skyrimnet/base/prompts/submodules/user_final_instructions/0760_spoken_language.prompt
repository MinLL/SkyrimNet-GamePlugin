{# The character's spoken language and the translation of their lines, in <translation> blocks SkyrimNet pairs with
   each sentence. decnpc(uuid).spokenLanguage and translationLanguage are {code, name} or nothing; a translation code
   of "game" has no name: the language the conversation is otherwise written in. #}
{% if render_mode == "full" or render_mode == "thoughts" %}
{% set spokenLanguage = decnpc(npc.UUID).spokenLanguage %}
{% set translatedLanguage = decnpc(npc.UUID).translationLanguage %}
{% if spokenLanguage or translatedLanguage %}
{% set speakerName = decnpc(npc.UUID).name %}
{% set spokenLanguageCode = "en" %}
{% if spokenLanguage %}{% set spokenLanguageCode = spokenLanguage.code %}{% endif %}
{% set translatedLanguageCode = "" %}
{% if translatedLanguage %}{% set translatedLanguageCode = translatedLanguage.code %}{% endif %}
{% set translatedLanguageName = "" %}
{% if translatedLanguage %}{% if translatedLanguageCode == "game" %}{% set translatedLanguageName = "the language this conversation is otherwise written in" %}{% else %}{% set translatedLanguageName = translatedLanguage.name %}{% endif %}{% endif %}
{% set languageExamples = {
  "ja": ["今はだめ。", "一時間後にまた来て。"],
  "ko": ["지금은 안 돼.", "한 시간 뒤에 다시 와."],
  "zh-Hans": ["现在不行。", "一个小时后再来。"],
  "zh-Hant": ["現在不行。", "一個小時後再來。"],
  "ru": ["Не сейчас.", "Возвращайся через час."],
  "it": ["Non ora.", "Torna tra un'ora."],
  "es": ["Ahora no.", "Vuelve dentro de una hora."],
  "pt": ["Agora não.", "Volte daqui a uma hora."],
  "de": ["Jetzt nicht.", "Komm in einer Stunde wieder."],
  "fr": ["Pas maintenant.", "Reviens dans une heure."],
  "ar": ["ليس الآن.", "ارجع بعد ساعة."],
  "pl": ["Nie teraz.", "Wróć za godzinę."],
  "nl": ["Nu niet.", "Kom over een uur terug."],
  "hi": ["अभी नहीं।", "एक घंटे बाद वापस आना।"],
  "he": ["לא עכשיו.", "תחזור בעוד שעה."],
  "cs": ["Teď ne.", "Vrať se za hodinu."],
  "hu": ["Most nem.", "Gyere vissza egy óra múlva."],
  "tr": ["Şimdi değil.", "Bir saat sonra tekrar gel."],
  "en": ["Not now.", "Come back in an hour."]
} %}
{% set spokenExamples = [] %}
{% if existsIn(languageExamples, spokenLanguageCode) %}{% set spokenExamples = at(languageExamples, spokenLanguageCode) %}{% endif %}
{% set translatedExamples = [] %}
{% if existsIn(languageExamples, translatedLanguageCode) %}{% set translatedExamples = at(languageExamples, translatedLanguageCode) %}{% endif %}
{% set hasMatchingExamples = length(spokenExamples) > 0 and (not translatedLanguage or length(translatedExamples) > 0) %}
{% if spokenLanguage %}
## Spoken Language
{% else %}
## Subtitle Translation
{% endif %}
{% if render_mode == "thoughts" %}
{% if spokenLanguage %}{{ speakerName }} speaks and thinks in {{ spokenLanguage.name }}. Write the thought in {{ spokenLanguage.name }}, in {{ speakerName }}'s voice.{% endif %}{% if translatedLanguage %} After {% if spokenLanguage %}it{% else %}the thought{% endif %}, inside <translation>...</translation>, give the same thought in {{ translatedLanguageName }}: a faithful translation, the same meaning and length, shown to the player only. One block, at the end, nothing after it.{% endif %}
{% if hasMatchingExamples %}
- Example: {{ spokenExamples.0 }} {{ spokenExamples.1 }}{% if translatedLanguage %} <translation>{{ translatedExamples.0 }} {{ translatedExamples.1 }}</translation>{% endif %}
{% endif %}
{% else %}
{% if spokenLanguage %}{{ speakerName }} speaks {{ spokenLanguage.name }}. Write every spoken sentence in {{ spokenLanguage.name }}, in {{ speakerName }}'s personality and register, using the established {{ spokenLanguage.name }} localization of Elder Scrolls names and terms.{% endif %}{% if translatedLanguage %} Right after each {% if not spokenLanguage %}spoken {% endif %}sentence, inside <translation>...</translation>, give that sentence in {{ translatedLanguageName }}: a faithful translation, the same meaning and length, for the subtitles only.{% endif %}
{% if translatedLanguage %}
- One <translation> block directly after each spoken sentence, the last one included: a sentence without its block is a mistake. Never put the translation first, never group several sentences into one block.
{% if is_audio_tags_enabled(npc.UUID) %}
- Keep [performance tags] in the sentence itself; do not repeat them inside the block.
{% endif %}
{% endif %}
{% if spokenLanguage %}
- Narration in *asterisks* and ACTION lines stay in the language this conversation is otherwise written in{% if translatedLanguage %}, with no block{% endif %}.
{% else %}
- Narration in *asterisks* and ACTION lines get no block.
{% endif %}
{% if exists("allow_inline_internal_thoughts") and allow_inline_internal_thoughts %}
{% if spokenLanguage and translatedLanguage %}
- Inside an <internal_thought> block, think in {{ spokenLanguage.name }} too and end the thought with one <translation> block holding the whole thought in {{ translatedLanguageName }}.
{% else if spokenLanguage %}
- Inside an <internal_thought> block, think in {{ spokenLanguage.name }} too.
{% else %}
- Inside an <internal_thought> block, end the thought with one <translation> block holding the whole thought in {{ translatedLanguageName }}.
{% endif %}
{% endif %}
{% if hasMatchingExamples %}
- Example: {{ spokenExamples.0 }}{% if translatedLanguage %} <translation>{{ translatedExamples.0 }}</translation>{% endif %}{% if is_narration_enabled() %} *{{ speakerName }} does not look up*{% endif %} {{ spokenExamples.1 }}{% if translatedLanguage %} <translation>{{ translatedExamples.1 }}</translation>{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
