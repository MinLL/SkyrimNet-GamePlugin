{# The character's spoken language and the translation of their lines, in <translation> blocks SkyrimNet pairs with
   each sentence. decnpc(uuid).spokenLanguage and translationLanguage are {code, name} or nothing; a translation code
   of "game" has no name: the language the conversation is otherwise written in. #}
{% if render_mode == "full" or render_mode == "thoughts" %}
{% set _sl = decnpc(npc.UUID).spokenLanguage %}
{% set _tl = decnpc(npc.UUID).translationLanguage %}
{% if _sl or _tl %}
{% set _name = decnpc(npc.UUID).name %}
{% set _sc = "en" %}
{% if _sl %}{% set _sc = _sl.code %}{% endif %}
{% set _tc = "" %}
{% if _tl %}{% set _tc = _tl.code %}{% endif %}
{% set _tln = "" %}
{% if _tl %}{% if _tc == "game" %}{% set _tln = "the language this conversation is otherwise written in" %}{% else %}{% set _tln = _tl.name %}{% endif %}{% endif %}
{% set _samples = {
  "ja": ["今はだめ。", "一時間後にまた来て。"],
  "ko": ["지금은 안 돼.", "한 시간 뒤에 다시 와."],
  "zh": ["现在不行。", "一个小时后再来。"],
  "zh-Hans": ["现在不行。", "一个小时后再来。"],
  "zh-Hant": ["現在不行。", "一個小時後再來。"],
  "ru": ["Не сейчас.", "Возвращайся через час."],
  "it": ["Non ora.", "Torna tra un'ora."],
  "es": ["Ahora no.", "Vuelve dentro de una hora."],
  "pt": ["Agora não.", "Volte daqui a uma hora."],
  "de": ["Jetzt nicht.", "Komm in einer Stunde wieder."],
  "fr": ["Pas maintenant.", "Reviens dans une heure."],
  "ar": ["ليس الآن.", "ارجع بعد ساعة."],
  "pl": ["Nie teraz.", "Wróć za godzinę."],
  "nl": ["Nu niet.", "Kom over een uur terug."],
  "hi": ["अभी नहीं।", "एक घंटे बाद वापस आना।"],
  "he": ["לא עכשיו.", "תחזור בעוד שעה."],
  "cs": ["Teď ne.", "Vrať se za hodinu."],
  "hu": ["Most nem.", "Gyere vissza egy óra múlva."],
  "tr": ["Şimdi değil.", "Bir saat sonra tekrar gel."],
  "en": ["Not now.", "Come back in an hour."]
} %}
{% set _ex = [] %}
{% if existsIn(_samples, _sc) %}{% set _ex = at(_samples, _sc) %}{% endif %}
{% set _tr = [] %}
{% if existsIn(_samples, _tc) %}{% set _tr = at(_samples, _tc) %}{% endif %}
{% set _example = length(_ex) > 0 and (not _tl or length(_tr) > 0) %}
{% if _sl %}
## Spoken Language
{% else %}
## Subtitle Translation
{% endif %}
{% if render_mode == "thoughts" %}
{% if _sl %}{{ _name }} speaks and thinks in {{ _sl.name }}. Write the thought in {{ _sl.name }}, in {{ _name }}'s voice.{% endif %}{% if _tl %} After {% if _sl %}it{% else %}the thought{% endif %}, inside <translation>...</translation>, give the same thought in {{ _tln }}: a faithful translation, the same meaning and length, shown to the player only. One block, at the end, nothing after it.{% endif %}
{% if _example %}
- Example: {{ _ex.0 }} {{ _ex.1 }}{% if _tl %} <translation>{{ _tr.0 }} {{ _tr.1 }}</translation>{% endif %}
{% endif %}
{% else %}
{% if _sl %}{{ _name }} speaks {{ _sl.name }}. Write every spoken sentence in {{ _sl.name }}, in {{ _name }}'s personality and register, using the established {{ _sl.name }} localization of Elder Scrolls names and terms.{% endif %}{% if _tl %} Right after each {% if not _sl %}spoken {% endif %}sentence, inside <translation>...</translation>, give that sentence in {{ _tln }}: a faithful translation, the same meaning and length, for the subtitles only.{% endif %}
{% if _tl %}
- One <translation> block directly after each spoken sentence, the last one included: a sentence without its block is a mistake. Never put the translation first, never group several sentences into one block.
{% if is_audio_tags_enabled(npc.UUID) %}
- Keep [performance tags] in the sentence itself; do not repeat them inside the block.
{% endif %}
{% endif %}
{% if _sl %}
- Narration in *asterisks* and ACTION lines stay in the language this conversation is otherwise written in{% if _tl %}, with no block{% endif %}.
{% else %}
- Narration in *asterisks* and ACTION lines get no block.
{% endif %}
{% if exists("allow_inline_internal_thoughts") and allow_inline_internal_thoughts %}
{% if _sl and _tl %}
- Inside an <internal_thought> block, think in {{ _sl.name }} too and end the thought with one <translation> block holding the whole thought in {{ _tln }}.
{% else if _sl %}
- Inside an <internal_thought> block, think in {{ _sl.name }} too.
{% else %}
- Inside an <internal_thought> block, end the thought with one <translation> block holding the whole thought in {{ _tln }}.
{% endif %}
{% endif %}
{% if _example %}
- Example: {{ _ex.0 }}{% if _tl %} <translation>{{ _tr.0 }}</translation>{% endif %}{% if is_narration_enabled() %} *{{ _name }} does not look up*{% endif %} {{ _ex.1 }}{% if _tl %} <translation>{{ _tr.1 }}</translation>{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
