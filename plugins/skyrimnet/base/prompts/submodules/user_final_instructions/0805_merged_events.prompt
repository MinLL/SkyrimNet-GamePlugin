{% if render_mode == "full" and exists("speech_turn") %}{% if speech_turn.merged_count > 1 %}{% set merged_lines = "" %}{% for e in speech_turn.also_events %}{% set merged_text = format_event(e, "compact") %}{% if merged_text != "" %}{% set merged_speaker = "" %}{% if e.type == "dialogue" or e.type == "dialogue_npc" or e.type == "dialogue_player" or e.type == "dialogue_player_stt" or e.type == "dialogue_player_text" or e.type == "dialogue_background" or e.type == "dialogue_player_telepathy" or e.type == "dialogue_npc_telepathy" or e.type == "dialogue_player_monologue" %}{% if isValidActor(e.originatingActor) %}{% set merged_speaker = get_name(e.originatingActor) + ": " %}{% else if e.type == "dialogue_background" %}{% if existsIn(e.data, "speaker") %}{% if e.data.speaker != "" %}{% set merged_speaker = e.data.speaker + ": " %}{% endif %}{% endif %}{% endif %}{% endif %}{% set merged_lines = merged_lines + "- " + merged_speaker + merged_text + "\n" %}{% endif %}{% endfor %}{% if merged_lines != "" %}
Along with what you are answering, these also just happened:
{{ merged_lines }}{% if speech_turn.mode == "together" %}Respond with a single line that reacts to them together, as a person would, rather than to each in turn.{% else %}Answer what you are answering first; you may briefly acknowledge the rest.{% endif %}
{% endif %}{% endif %}{% endif %}
