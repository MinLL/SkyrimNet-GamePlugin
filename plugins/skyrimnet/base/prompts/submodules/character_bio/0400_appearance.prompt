{% set _profile = render_mode == "stable" or render_mode == "thoughts" or render_mode == "transform" or (render_mode == "full" and not default(stable_split, false)) %}
{% if _profile or render_mode == "dialogue_target" or render_mode == "bio_appearance" %}
    {% if _profile or render_mode == "dialogue_target" %}
        ## Appearance & Physical State
    {% endif %}
    {% if has_omnisight_description("actor", actorUUID) %}
        {{ get_omnisight_description("actor", actorUUID) }}
    {% else %}
        {% set appearance_form = get_appearance_form(actorUUID) %}
        {% if length(appearance_form) > 0 %}
        {{ decnpc(actorUUID).name }} is currently in {{ lower(appearance_form) }} form.
        {% endif %}
        {% block appearance %}{% endblock %}
    {% endif %}
{% endif %}
