{% set _profile = render_mode == "stable" or render_mode == "thoughts" or render_mode == "transform" or (render_mode == "full" and not default(stable_split, false)) %}
{# Suppressed for a body fully worn by a linked entity (entity_led); the "bio_aspirations"
   pull that lends the ENTITY's goals in 7050_identity_links always renders. #}
{% if render_mode == "bio_aspirations" or (_profile and not suppress_host_persona) %}
    {% if _profile %}
        ## Goals & Aspirations
    {% endif %}
    {% block aspirations %}{% endblock %}
{% endif %}
