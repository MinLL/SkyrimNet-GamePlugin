{# Use events context variable if set by C++, otherwise fetch via decorator #}
{% if not exists("events") or length(events) == 0 %}{% set _event_filter = [] %}
{% if exists("npc") and existsIn(npc, "UUID") %}{% set _event_filter = append(_event_filter, npc.UUID) %}{% endif %}
{% if exists("maxRecentEvents") %}{% set _event_count = maxRecentEvents %}{% else if exists("npc") and existsIn(npc, "UUID") %}{% set _event_count = get_event_history_count(npc.UUID) %}{% else %}{% set _event_count = get_event_history_count(0) %}{% endif %}
{% set events = get_recent_events(_event_count, _event_filter) %}{% endif %}
{% set _npc_is_private_virtual = false %}
{% if exists("npc") and existsIn(npc, "UUID") %}{% set _npc_is_private_virtual = decnpc(npc.UUID).isVirtualPrivate %}{% endif %}
{# cache_history (the prompts laid out for caching): a sliding window would change the opening of
   the history on every reply and defeat prompt caching, so it starts at an anchor instead, the first
   event whose id reaches the next multiple of a step. The step starts as the largest power of two
   within a quarter of the window's id span, and comes down until the anchor hides at most a quarter
   of the events shown: ids can cluster, so a quarter of the span can be most of the window. Other
   prompts have no breakpoint here and see the whole window. #}
{% set _anchorId = 0 %}
{% if default(cache_history, false) and length(events) > 0 and existsIn(first(events), "id") %}
{% set _firstId = first(events).id %}
{% set _span = last(events).id - _firstId %}
{% set _step = 1 %}
{% if _span >= 1024 %}{% set _step = 256 %}{% else if _span >= 512 %}{% set _step = 128 %}{% else if _span >= 256 %}{% set _step = 64 %}{% else if _span >= 128 %}{% set _step = 32 %}{% else if _span >= 64 %}{% set _step = 16 %}{% else if _span >= 32 %}{% set _step = 8 %}{% else if _span >= 16 %}{% set _step = 4 %}{% else if _span >= 8 %}{% set _step = 2 %}{% endif %}
{% set _shownCount = 0 %}
{% for event in events %}{% if event.type != "spell" and event.type != "hit" and event.type != "combat" %}{% set _shownCount = _shownCount + 1 %}{% endif %}{% endfor %}
{% set _anchorSet = false %}
{% set _steps = [256, 128, 64, 32, 16, 8, 4, 2, 1] %}
{% for _trial in _steps %}{% if not _anchorSet and _trial <= _step %}
{% set _candidate = _firstId + (_trial - _firstId % _trial) % _trial %}
{% set _hidden = 0 %}
{% for event in events %}{% if default(event.id, 0) < _candidate and event.type != "spell" and event.type != "hit" and event.type != "combat" %}{% set _hidden = _hidden + 1 %}{% endif %}{% endfor %}
{% if _hidden * 4 <= _shownCount %}{% set _anchorId = _candidate %}{% set _anchorSet = true %}{% endif %}
{% endif %}{% endfor %}
{% endif %}
{% set lastLocation = "" %}
{% set _lastBuilding = "" %}
{% set _speakerLocations = [] %}{# [actor, location of their last line] #}
{% set lastEventTime = 0 %}
{% set lastEventLocation = "" %}
{% set lastSignificantTime = 0 %}
{% set latestGMDialogueTime = 0 %}
{% for event in events %}{% if event.type == "gamemaster_dialogue" and default(event.id, 0) >= _anchorId %}{% set latestGMDialogueTime = event.gameTime %}{% endif %}{% endfor %}
{# Under cache_history the last event's message is a prompt-cache breakpoint, so the system message
   and the history up to it are cached together. #}
{% set _cacheId = -1 %}
{% if default(cache_history, false) %}
{% for event in events %}{% if default(event.id, 0) >= _anchorId and event.type != "spell" and event.type != "hit" and event.type != "combat" and (event.type != "gamemaster_dialogue" or event.gameTime == latestGMDialogueTime) %}{% set _cacheId = default(event.id, -1) %}{% endif %}{% endfor %}
{% endif %}
{% set hasShownGMDialogue = false %}
{% for event in events %}
    {% if default(event.id, 0) >= _anchorId and event.type != "spell" and event.type != "hit" and event.type != "combat" %}
        {# A move is a line from another building than the line before (location_building, the first part;
           ai_docs/NAMED_PLACES.md), or a speaker standing elsewhere than at their own last line: two people talking
           from two rooms of one building is not one. #}
        {% set _prevSpeaker = [] %}{% for _pair in _speakerLocations %}{% if _pair.0 == event.originatingActor %}{% set _prevSpeaker = _pair %}{% endif %}{% endfor %}
        {% set _building = location_building(event.location) %}{% if length(_prevSpeaker) > 0 %}{% set _ownMove = (event.location != _prevSpeaker.1) %}{% else %}{% set _ownMove = false %}{% endif %}{% set locationChanged = (lastLocation != "" and (_building != _lastBuilding or _ownMove)) %}
        {% set timeDiff = gameTimeNumeric - event.gameTime %}
        {% if lastSignificantTime > 0 %}
            {% set timeSinceLastSignificant = event.gameTime - lastSignificantTime %}
        {% else %}
            {% set timeSinceLastSignificant = 0 %}
        {% endif %}
        {% set timeIndicator = "" %}
        {% set showTimeGap = false %}

        {% if timeDiff > 604800 %}{% set timeIndicator = "[Over a week ago] " %}
        {% else if timeDiff > 172800 %}{% set timeIndicator = "[Several days ago] " %}
        {% else if timeDiff > 86400 %}{% set timeIndicator = "[Yesterday] " %}
        {% else if timeDiff > 28800 %}{% set timeIndicator = "[Many hours ago] " %}
        {% else if timeDiff > 14400 %}{% set timeIndicator = "[Earlier today] " %}
        {% else if timeDiff > 7200 %}{% set timeIndicator = "[A few hours ago] " %}
        {% else if timeDiff > 3600 %}{% set timeIndicator = "[About an hour ago] " %}
        {% else if timeDiff > 1800 %}{% set timeIndicator = "[A while ago] " %}
        {% endif %}

        {% if timeSinceLastSignificant > 1800 %}{% set showTimeGap = true %}{% endif %}

        {% if showTimeGap and lastSignificantTime > 0 %}
            {% set gapDescription = "" %}
            {% if timeSinceLastSignificant > 31536000 %}{% set gapDescription = "Over a year later..." %}
            {% else if timeSinceLastSignificant > 15552000 %}{% set gapDescription = "Many months later..." %}
            {% else if timeSinceLastSignificant > 7776000 %}{% set gapDescription = "Several months later..." %}
            {% else if timeSinceLastSignificant > 5184000 %}{% set gapDescription = "A couple months later..." %}
            {% else if timeSinceLastSignificant > 2592000 %}{% set gapDescription = "A month later..." %}
            {% else if timeSinceLastSignificant > 1209600 %}{% set gapDescription = "A couple weeks later..." %}
            {% else if timeSinceLastSignificant > 604800 %}{% set gapDescription = "A week later..." %}
            {% else if timeSinceLastSignificant > 86400 %}{% set gapDescription = "The next day..." %}
            {% else if timeSinceLastSignificant > 28800 %}{% set gapDescription = "Many hours later..." %}
            {% else if timeSinceLastSignificant > 14400 %}{% set gapDescription = "Several hours pass..." %}
            {% else if timeSinceLastSignificant > 7200 %}{% set gapDescription = "A few hours later..." %}
            {% else if timeSinceLastSignificant > 3600 %}{% set gapDescription = "About an hour passes..." %}
            {% else if timeSinceLastSignificant > 1800 %}{% set gapDescription = "Some time passes..." %}
            {% endif %}
[ user ]
            *{{ gapDescription }}*. It is now {{ event.gameTimeStr }}.
[ end user ]
        {% endif %}

        {% set _cacheHere = default(event.id, 0) == _cacheId %}
        {% if event.type == "gamemaster_dialogue" %}
            {% if event.gameTime == latestGMDialogueTime and not hasShownGMDialogue %}
[ user ]
{% if _cacheHere %}[ cache ]{% endif %}
            {{ format_event(event, "verbose") }}
{% if _cacheHere %}[ end cache ]{% endif %}
[ end user ]
                {% set hasShownGMDialogue = true %}
            {% endif %}
        {% else if event.originatingActor == npc.UUID and event.type != "player_thoughts" and event.type != "direct_narration" %}
[ assistant ]
{% if _cacheHere %}[ cache ]{% endif %}
            {{ format_event(event, "verbose") }}
{% if _cacheHere %}[ end cache ]{% endif %}
[ end assistant ]
        {% else %}
[ user ]
{% if _cacheHere %}[ cache ]{% endif %}
            {% if locationChanged %}[Location changed to {{ event.location }}] {% endif %}{% if event.type == "direct_narration" %}{% if not default(cache_history, false) %}{{ timeIndicator }}{% endif %}*{{ format_event(event, "verbose") }}*
            {% else %}
            {% if event.type == "player_thoughts" %}{{ format_event(event, "verbose") }}
            {% else if event.type == "npc_thoughts" %}{# Telepathy: an NPC's private thought rendered into a different actor's prompt context (canonical-telepath audience expansion). Mark it as telepathically observed so the LLM doesn't mistake it for spoken dialogue. Use "compact" (renders {{ thoughts }} via the schema), not "raw" — "raw" dumps the JSON data object. #}{{ get_name(event.originatingActor) }} *(thought, telepathically observed)*: {{ format_event(event, "compact") }}
            {% else %}{% if event.type == "dialogue_background" %}[Background] {% endif %}{% if isValidActor(event.originatingActor) %}{{ get_name(event.originatingActor) }}{% if isValidActor(event.targetActor) %}{% if decnpc(event.targetActor).isVirtualPrivate and not _npc_is_private_virtual %}{% if decnpc(event.originatingActor).isFemale %} (talking to herself){% else %} (talking to himself){% endif %}{% else %} (to {{ get_name(event.targetActor) }}){% endif %}{% endif %}: {% else if event.type == "dialogue_background" and event.data and event.data.speaker != "" %}{{ event.data.speaker }}: {% endif %}{{ format_event(event, "verbose") }}
            {% endif %}
            {% endif %}
{% if _cacheHere %}[ end cache ]{% endif %}
[ end user ]
        {% endif %}
        {% set lastLocation = event.location %}{% set _lastBuilding = _building %}
        {% if length(_prevSpeaker) > 0 %}{% set _speakerLocations = remove(_speakerLocations, _prevSpeaker) %}{% endif %}{% set _speakerLocations = append(_speakerLocations, append(append([], event.originatingActor), event.location)) %}
        {% if existsIn(event, "gameTimeEnd") and event.gameTimeEnd %}{% set lastEventTime = event.gameTimeEnd %}{% else %}{% set lastEventTime = event.gameTime %}{% endif %}
        {% set lastEventLocation = event.location %}
        {% if showTimeGap or lastSignificantTime == 0 %}{% if existsIn(event, "gameTimeEnd") and event.gameTimeEnd %}{% set lastSignificantTime = event.gameTimeEnd %}{% else %}{% set lastSignificantTime = event.gameTime %}{% endif %}{% endif %}
    {% endif %}
{% endfor %}
{% if lastEventTime > 0 %}
    {% if exists("npc") and existsIn(npc, "UUID") %}{% set currentActorLocation = get_location(npc.UUID) %}{% else %}{% set currentActorLocation = location %}{% endif %}
    {% set timeSinceLastEvent = gameTimeNumeric - lastEventTime %}
    {# Moved: the prompted NPC stands in another building than the last line, or elsewhere than at their own
       last line. #}
    {% set _npcLast = [] %}{% if exists("npc") and existsIn(npc, "UUID") %}{% for _pair in _speakerLocations %}{% if _pair.0 == npc.UUID %}{% set _npcLast = _pair %}{% endif %}{% endfor %}{% endif %}
    {% if length(_npcLast) > 0 %}{% set _ownMove = (_npcLast.1 != currentActorLocation) %}{% else %}{% set _ownMove = false %}{% endif %}{% set locationChangedSinceLastEvent = (lastEventLocation != "" and (location_building(currentActorLocation) != _lastBuilding or _ownMove)) %}
    {% set timePassedDescription = "" %}
    {% if timeSinceLastEvent > 31536000 %}{% set timePassedDescription = "Over a year has passed" %}
    {% else if timeSinceLastEvent > 15552000 %}{% set timePassedDescription = "Many months have passed" %}
    {% else if timeSinceLastEvent > 7776000 %}{% set timePassedDescription = "Several months have passed" %}
    {% else if timeSinceLastEvent > 5184000 %}{% set timePassedDescription = "A couple months have passed" %}
    {% else if timeSinceLastEvent > 2592000 %}{% set timePassedDescription = "A month has passed" %}
    {% else if timeSinceLastEvent > 1209600 %}{% set timePassedDescription = "A couple weeks have passed" %}
    {% else if timeSinceLastEvent > 604800 %}{% set timePassedDescription = "Over a week has passed" %}
    {% else if timeSinceLastEvent > 172800 %}{% set timePassedDescription = "Several days have passed" %}
    {% else if timeSinceLastEvent > 86400 %}{% set timePassedDescription = "A day has passed" %}
    {% else if timeSinceLastEvent > 28800 %}{% set timePassedDescription = "Many hours have passed" %}
    {% else if timeSinceLastEvent > 14400 %}{% set timePassedDescription = "Several hours have passed" %}
    {% else if timeSinceLastEvent > 7200 %}{% set timePassedDescription = "A few hours have passed" %}
    {% else if timeSinceLastEvent > 3600 %}{% set timePassedDescription = "About an hour has passed" %}
    {% else if timeSinceLastEvent > 1800 %}{% set timePassedDescription = "Some time has passed" %}
    {% else if timeSinceLastEvent > 600 %}{% set timePassedDescription = "A little time has passed" %}
    {% endif %}
    {% if timePassedDescription != "" or locationChangedSinceLastEvent %}
[ user ]
        {% if timePassedDescription != "" %}*{{ timePassedDescription }}{% if locationChangedSinceLastEvent %}, and the location has changed to {{ currentActorLocation }}{% endif %}.*{% else %}*The location has changed to {{ currentActorLocation }}.*{% endif %}
[ end user ]
    {% endif %}
{% endif %}
