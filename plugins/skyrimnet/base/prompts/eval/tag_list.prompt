{% for t in tag_list %}
- {{ t }}: {% if t == "flat" %}flat or generic{% else if t == "unnatural" %}unnatural or stilted{% else if t == "out_of_character" %}out of character{% else if t == "wrong_tone" %}the wrong tone for the moment{% else if t == "ignored_input" %}ignored what was said to it{% else if t == "wrong_facts" %}wrong facts{% else if t == "too_long" %}too long{% else if t == "repeated" %}repeated itself{% else if t == "broke_format" %}broke the reply format{% else if t == "spoke_for_player" %}spoke or acted for the player{% else if t == "changed_meaning" %}changed what was meant{% else if t == "not_translated" %}left untranslated{% else if t == "invented" %}made things up{% else if t == "missed_important" %}missed something important{% else if t == "trivial" %}not worth remembering{% else if t == "wrong_perspective" %}written from the wrong point of view{% else if t == "irrelevant" %}irrelevant to the moment{% else if t == "too_vague" %}too vague to find anything{% else if t == "dropped_info" %}dropped what was already known{% else if t == "hallucinated" %}describes things that are not there{% else if t == "wrong_tool" %}used the wrong tool{% else if t == "wrong_arguments" %}gave the tool the wrong arguments{% else %}{{ t }}{% endif %}
{% endfor %}
